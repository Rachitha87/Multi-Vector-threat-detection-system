-6 max-w-(--user-chat-width,70%)"><div class=3D"whitespace-pre-wrap">import=
 pickle
import re


# Load ML model
model =3D pickle.load(open("models/bec_model.pkl", "rb"))
vectorizer =3D pickle.load(open("models/vectorizer.pkl", "rb"))


# trusted domains
trusted_domains =3D[=20
    "gmail.com",
    "outlook.com",
    "yahoo.com",
    "company.com"
]


suspicious_words =3D [
    "urgent",
    "immediately",
    "transfer",
    "wire",
    "bank",
    "payment",
    "invoice",
    "confirm",
    "account",
    "gift card"
]


def predict_email(text, sender_email):

    # ---------- ML prediction ----------

    vec =3D vectorizer.transform([text])

    prediction =3D model.predict(vec)[0]
    probability =3D model.predict_proba(vec).max()


    # ---------- Rule Based Detection ----------

    risk_score =3D 0


    # check suspicious words
    text_lower =3D text.lower()

    for word in suspicious_words:
        if word in text_lower:
            risk_score +=3D 1


    # check money pattern
    if re.search(r"\$\d+", text):
        risk_score +=3D 2


    # check sender domain
    domain =3D sender_email.split("@")[-1]

    if domain not in trusted_domains:
        risk_score +=3D 1


    # check fake domain pattern
    if "paypa1" in domain or "g00gle" in domain:
        risk_score +=3D 2


    # override ML if many risks
    if risk_score &gt;=3D 3:
        prediction =3D "spam"
        probability =3D 0.95


    return prediction, probability   modify give complete code</div></div><=
/div></div></div><div class=3D"z-0 flex justify-end"><div class=3D"touch:-m=
e-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 sel=
ect-none focus-within:transition-none hover:transition-none touch:pointer-e=
