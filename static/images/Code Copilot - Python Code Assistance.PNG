nd-color: rgb(29, 161, 242); border-radius: 50%; width: 15px; height: 15px;=
 }

.mapboxgl-user-location-dot::before { content: ""; animation: 2s ease 0s in=
finite normal none running mapboxgl-user-location-dot-pulse; position: abso=
lute; }

.mapboxgl-user-location-dot::after { box-sizing: border-box; content: ""; b=
order: 2px solid rgb(255, 255, 255); border-radius: 50%; width: 19px; heigh=
t: 19px; position: absolute; top: -2px; left: -2px; box-shadow: rgba(0, 0, =
