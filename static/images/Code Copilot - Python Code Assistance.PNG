import pandas as pd
from modules.phishing_feature_extractor import extract_features


# Load trained model
model =3D pickle.load(open("models/phishing_model.pkl", "rb"))


# IMPORTANT: dataset feature order (must match training)=20
feature_order =3D [
    "having_IPhaving_IP_Address",
    "URLURL_Length",
    "Shortining_Service",
    "having_At_Symbol",
    "double_slash_redirecting",
    "Prefix_Suffix",
    "having_Sub_Domain",
    "SSLfinal_State",
    "Domain_registeration_length",
    "Favicon",
    "port",
    "HTTPS_token",
    "Request_URL",
    "URL_of_Anchor",
    "Links_in_tags",
    "SFH",
    "Submitting_to_email",
    "Abnormal_URL",
    "Redirect",
    "on_mouseover",
    "RightClick",
    "popUpWidnow",
    "Iframe",
    "age_of_domain",
    "DNSRecord",
    "web_traffic",
    "Page_Rank",
    "Google_Index",
    "Links_pointing_to_page",
    "Statistical_report"
]


def predict_url(url):

    # Extract features
    df, feature_dict =3D extract_features(url)

    # Ensure same feature order as training
    df =3D df[feature_order]

    # ML prediction
    prediction =3D model.predict(df)[0]
    probability =3D model.predict_proba(df).max()


    # ---------- Rule Based Risk Layer ----------

    risk_score =3D 0

    if feature_dict["Prefix_Suffix"] =3D=3D 1:
        risk_score +=3D 1

    if feature_dict["Abnormal_URL"] =3D=3D 1:
        risk_score +=3D 1

    if feature_dict["SSLfinal_State"] =3D=3D 0:
        risk_score +=3D 1

    if feature_dict["having_Sub_Domain"] =3D=3D 1:
        risk_score +=3D 1


    # If many phishing signals exist =E2=86=92 override ML
    if risk_score &gt;=3D 2:
        prediction =3D 1


    return prediction, probability, feature_dict  this is code you can add =
