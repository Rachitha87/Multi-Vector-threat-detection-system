from flask import Flask, render_template, request
from modules.bec_detector import predict_email
from modules.phishing_detector import predict_url
from modules.image_stego_detector import detect_hidden_data
import os

app =3D Flask(__name__)

UPLOAD_FOLDER =3D "static/images"
app.config["UPLOAD_FOLDER"] =3D UPLOAD_FOLDER


@app.route("/")
def login():
    return render_template("login.html")


@app.route("/dashboard")
def dashboard():
    return render_template("dashboard.html")


# PHISHING DETECTION
@app.route("/phishing", methods=3D["GET", "POST"])
def phishing():

    result =3D None
    confidence =3D None

    if request.method =3D=3D "POST":

        url =3D request.form["url"]

        pred, prob, features =3D predict_url(url)

        result =3D "Phishing Website" if pred =3D=3D 1 else "Safe Website"
        confidence =3D round(prob * 100, 2)

    return render_template("phishing.html", result=3Dresult, confidence=3Dc=
onfidence)

# BEC EMAIL DETECTIon
@app.route("/bec", methods=3D["GET", "POST"])
def bec():


    result =3D None
    confidence =3D None

    if request.method =3D=3D "POST":

        email =3D request.form["email"]

        pred, prob =3D predict_email(email)

        result =3D "Malicious Email" if pred =3D=3D "spam" else "Safe Email=
"
        confidence =3D round(prob * 100, 2)

    return render_template("bec.html", result=3Dresult, confidence=3Dconfid=
ence)


# IMAGE STEGANOGRAPHY DETECTION
@app.route("/image", methods=3D["GET", "POST"])
def image():

    result =3D None

    if request.method =3D=3D "POST":

        file =3D request.files["image"]

        path =3D os.path.join(app.config["UPLOAD_FOLDER"], file.filename)

        file.save(path)

        result =3D detect_hidden_data(path)

    return render_template("image.html", result=3Dresult)


if __name__ =3D=3D "__main__":
