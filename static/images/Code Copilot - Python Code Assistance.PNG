dow-detect; animation-range: normal; animation-timeline: --scroll-shadow !i=
mportant; }
  .horizontal-scroll-shadow-container::before, .horizontal-scroll-shadow-co=
ntainer::after, .vertical-scroll-shadow-container::before, .vertical-scroll=
