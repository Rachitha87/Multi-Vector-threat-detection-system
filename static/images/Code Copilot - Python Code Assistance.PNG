.mapboxgl-ctrl-bottom-left .mapboxgl-ctrl, .mapboxgl-ctrl-left .mapboxgl-ct=
rl { float: left; margin: 0px 0px 10px 10px; }

.mapboxgl-ctrl-group { background: rgb(255, 255, 255); border-radius: 4px; =
}

