import pandas as pd
from modules.phishing_feature_extractor import extract_features

model =3D pickle.load(open("models/phishing_model.pkl","rb"))

def predict_url(url):

    feature_list, feature_dict =3D extract_features(url)

    df =3D pd.DataFrame([feature_list])

    prediction =3D model.predict(df)[0]

    probability =3D model.predict_proba(df).max()

    return prediction, probability, feature_dict    phishing_detection.py  =
and   import re

def extract_features(url):

    features =3D {}

    # 1 URL length
    features["url_length"] =3D len(url)

    # 2 number of dots
    features["num_dots"] =3D url.count(".")

    # 3 number of hyphens
    features["num_hyphen"] =3D url.count("-")

    # 4 number of digits
    features["num_digits"] =3D len(re.findall(r'\d', url))

    # 5 presence of @ symbol
    features["has_at"] =3D 1 if "@" in url else 0

    # 6 https usage
    features["https"] =3D 1 if url.startswith("https") else 0

    # 7 suspicious words
    suspicious_words =3D ["login","verify","bank","secure","account","updat=
e"]

    features["suspicious_words"] =3D 1 if any(word in url for word in suspi=
cious_words) else 0

    return list(features.values()), features     feature_extraction.py and =
 import pandas as pd
import pickle
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier

data =3D pd.read_csv("datasets/phishing_dataset.csv")

# simple numeric features from dataset
data["url_length"] =3D data["URLURL_Length"]
data["num_dots"] =3D data["having_Sub_Domain"]
data["num_hyphen"] =3D data["Prefix_Suffix"]
data["num_digits"] =3D data["Links_pointing_to_page"]
data["has_at"] =3D data["having_At_Symbol"]
data["https"] =3D data["HTTPS_token"]
data["suspicious_words"] =3D data["Abnormal_URL"]

X =3D data[
    [
        "url_length",
        "num_dots",
        "num_hyphen",
        "num_digits",
        "has_at",
        "https",
        "suspicious_words"
    ]
]

y =3D data["Result"]

X_train, X_test, y_train, y_test =3D train_test_split(
    X, y, test_size=3D0.2, random_state=3D42
)

model =3D RandomForestClassifier(n_estimators=3D100)

model.fit(X_train, y_train)

pickle.dump(model, open("models/phishing_model.pkl", "wb"))

print("Phishing model trained successfully")   trainining data  and &lt;!DO=
