.=CD=BCd { color: var(--orange-600); }

.=CD=BCe { color: var(--purple-600); }

.=CD=BCf { color: var(--yellow-600); }

.=CD=BCg { color: var(--blue-600); }

.=CD=BCh { color: var(--blue-600); text-decoration: underline; }

.=CD=BCi { color: var(--red-600); text-decoration: underline; }

.=CD=BCj .cm-lineNumbers .cm-gutterElement { padding-left: 8px; }

.=CD=BCj .cm-cursor, .=CD=BCj .cm-dropCursor { border-left-width: 2px; }

.=CD=BCj .cm-matchingBracket { outline: 1px solid var(--blue-600); color: i=
nherit; }

.=CD=BCj .cm-nonmatchingBracket { outline: 1px solid var(--red-600); color:=
 inherit; }
