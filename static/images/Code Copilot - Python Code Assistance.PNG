(--user-chat-width,70%)"><div class=3D"whitespace-pre-wrap">import pickle
from modules.stego_feature_extractor import extract_features
from PIL import Image
import numpy as np


model =3D pickle.load(open("models/stego_model.pkl", "rb"))


def extract_message(image_path):

    img =3D Image.open(image_path).convert("RGB")

    pixels =3D np.array(img)

    binary =3D ""

    for row in pixels:
        for pixel in row:

            r, g, b =3D pixel

            binary +=3D str(r &amp; 1)
            binary +=3D str(g &amp; 1)
            binary +=3D str(b &amp; 1)

    chars =3D [binary[i:i+8] for i in range(0, len(binary), 8)]

    message =3D ""

    for c in chars:

        if len(c) &lt; 8:
            break

        char =3D chr(int(c, 2))

        if char =3D=3D "#":
            break

        message +=3D char

    return message


def detect_hidden_data(image_path):

    features =3D extract_features(image_path)

    pred =3D model.predict([features])[0]

    if pred =3D=3D 1:

        msg =3D extract_message(image_path)

        if msg.strip() !=3D "":
            return f"Hidden data detected. Message: {msg}"

        return "Hidden data detected but message not readable"

    return "No hidden data detected"    this is the working code i have now=
