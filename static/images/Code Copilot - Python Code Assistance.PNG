.mapboxgl-user-location-show-heading .mapboxgl-user-location-heading::after=
, .mapboxgl-user-location-show-heading .mapboxgl-user-location-heading::bef=
ore { content: ""; border-bottom: 7.5px solid rgb(74, 161, 235); position: =
absolute; }

.mapboxgl-user-location-show-heading .mapboxgl-user-location-heading::befor=
e { border-left: 7.5px solid rgba(0, 0, 0, 0); transform: translateY(-28px)=
